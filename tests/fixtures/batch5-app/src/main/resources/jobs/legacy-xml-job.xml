<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:batch="http://www.springframework.org/schema/batch">
  <batch:job id="legacyXmlJob">
    <batch:step id="extract" next="transform">
      <batch:tasklet>
        <batch:chunk reader="rowReader" processor="rowProcessor" writer="rowWriter" commit-interval="50" skip-limit="5">
          <batch:skippable-exception-classes>
            <batch:include class="org.springframework.batch.item.file.FlatFileParseException"/>
          </batch:skippable-exception-classes>
        </batch:chunk>
      </batch:tasklet>
    </batch:step>
    <batch:step id="transform">
      <batch:tasklet ref="transformTasklet"/>
      <batch:next on="FAILED" to="cleanup"/>
      <batch:end on="*"/>
    </batch:step>
    <batch:step id="cleanup">
      <batch:tasklet ref="cleanupTasklet"/>
    </batch:step>
  </batch:job>
</beans>
