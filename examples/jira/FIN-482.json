                      "type": "text",
                      "text": "File must be pipe-delimited with the same header as the invoice file"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "File must end with a trailer line T|<record count>"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Amounts should be exported as negative cents"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Nice to have: email ops when more than 10 records are skipped"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
